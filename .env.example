# Copy this file to .env and adjust. .env is git-ignored, so your key stays local.
#   cp .env.example .env

# Provider: "openai" (the assignment stack) or "ollama" (local, free, no key).
PROVIDER=openai

# --- OpenAI settings, used when PROVIDER=openai ---------------------------
OPENAI_API_KEY=your_key_here
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o

# --- Ollama settings, used when PROVIDER=ollama ---------------------------
# Pull the models first:
#   ollama pull nomic-embed-text
#   ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Optional overrides ---------------------------------------------------
# LLM_TEMPERATURE=0.0
# CHUNK_SIZE=1100
# CHUNK_OVERLAP=200
# DEFAULT_TOP_K=6
# RETRIEVAL_MODE=balanced        # "balanced" (per-document quota) or "plain"
# MIN_PER_DOC_TYPE=2
# COLLECTION_NAME=supply_chain_docs
# API_BASE_URL=http://localhost:8000
# REQUEST_TIMEOUT=120            # seconds to wait for one model call
# MAX_RETRIES=2                  # retries for a stalled or failed model call
